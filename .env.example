POSTGRES_PASSWORD=replace_with_secure_password
# The dev compose stack publishes Postgres on host port 5433 and Redis on 6380
# (infrastructure/docker/docker-compose.yml) — the host ports are deliberately
# offset from the container defaults to avoid clashing with other local stacks.
DATABASE_URL=postgresql://clario_admin:replace_with_secure_password@localhost:5433/clario?schema=public
DIRECT_URL=postgresql://clario_admin:replace_with_secure_password@localhost:5433/clario?schema=public
REDIS_URL=redis://localhost:6380
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- F-64 / F-65 authentication (defaults match the documented MVP values) ---
# Express `trust proxy` hop count used to derive the client IP (0 = disabled).
TRUST_PROXY_HOPS=0
# Absolute session lifetime in minutes.
SESSION_ABSOLUTE_LIFETIME_MINUTES=720
# Per-role inactivity timeouts in minutes.
SESSION_INACTIVITY_TIMEOUT_MINUTES_PLATFORM_ADMIN=30
SESSION_INACTIVITY_TIMEOUT_MINUTES_INSTITUTIONAL_ADMIN=30
SESSION_INACTIVITY_TIMEOUT_MINUTES_PROJECT_COORDINATOR=30
SESSION_INACTIVITY_TIMEOUT_MINUTES_PROJECT_SUPERVISOR=60
SESSION_INACTIVITY_TIMEOUT_MINUTES_PROJECT_EXAMINER=60
SESSION_INACTIVITY_TIMEOUT_MINUTES_STUDENT=60
# Login protection: sliding window + escalating cooldown.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_BASE_COOLDOWN_MINUTES=15
LOGIN_LOCKOUT_COOLDOWN_MULTIPLIER=2
LOGIN_LOCKOUT_MAX_COOLDOWN_MINUTES=60
# In-flight Argon2id verification caps, enforced before the KDF runs:
# per client IP and per identifier, and process-wide (memory ceiling).
LOGIN_MAX_CONCURRENT_VERIFICATIONS=5
LOGIN_MAX_CONCURRENT_VERIFICATIONS_GLOBAL=16
# Lifetime of the single-use self-service password-reset token, in minutes.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Base64-encoded 32-byte key that encrypts the secrets carried by the
# transactional outbox (the single-use password-reset token). The value below
# is the documented development placeholder — it is rejected in production.
# Generate a real one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
OUTBOX_PAYLOAD_ENCRYPTION_KEY=Y2xhcmlvLWRldi1vbmx5LXBheWxvYWQta2V5LTAwMDA=
