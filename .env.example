POSTGRES_PASSWORD=replace_with_secure_password
DATABASE_URL=postgresql://clario_admin:replace_with_secure_password@localhost:5432/clario?schema=public
DIRECT_URL=postgresql://clario_admin:replace_with_secure_password@localhost:5432/clario?schema=public
REDIS_URL=redis://localhost:6379
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- F-64 / F-65 authentication (defaults match the documented MVP values) ---
# Express `trust proxy` hop count used to derive the client IP (0 = disabled).
TRUST_PROXY_HOPS=0
# Absolute session lifetime in minutes.
SESSION_ABSOLUTE_LIFETIME_MINUTES=720
# Per-role inactivity timeouts in minutes.
SESSION_INACTIVITY_TIMEOUT_MINUTES_PLATFORM_ADMIN=30
SESSION_INACTIVITY_TIMEOUT_MINUTES_INSTITUTIONAL_ADMIN=30
SESSION_INACTIVITY_TIMEOUT_MINUTES_PROJECT_COORDINATOR=30
SESSION_INACTIVITY_TIMEOUT_MINUTES_PROJECT_SUPERVISOR=60
SESSION_INACTIVITY_TIMEOUT_MINUTES_PROJECT_EXAMINER=60
SESSION_INACTIVITY_TIMEOUT_MINUTES_STUDENT=60
# Login protection: sliding window + escalating cooldown.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_BASE_COOLDOWN_MINUTES=15
LOGIN_LOCKOUT_COOLDOWN_MULTIPLIER=2
LOGIN_LOCKOUT_MAX_COOLDOWN_MINUTES=60
