/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model audit_logs {
  id                               String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sequence_num                     BigInt        @unique @default(autoincrement())
  institution_id                   String?       @db.Uuid
  programme_id                     String?       @db.Uuid
  academic_session_id              String?       @db.Uuid
  project_id                       String?       @db.Uuid
  actor_user_id                    String?       @db.Uuid
  actor_role                       String        @db.VarChar(50)
  actor_ip                         String?       @db.Inet
  action_code                      String        @db.VarChar(100)
  is_confidential_academic_payload Boolean       @default(false)
  target_entity_type               String        @db.VarChar(80)
  target_entity_id                 String        @db.Uuid
  previous_state_jsonb             Json?
  resulting_state_jsonb            Json?
  justification_reason             String?
  outcome                          String        @db.VarChar(20)
  previous_row_hash                String?       @db.Char(64)
  row_integrity_hash               String        @db.Char(64)
  created_at                       DateTime      @default(now()) @db.Timestamptz(6)
  institutions                     institutions? @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([institution_id, target_entity_type, target_entity_id, created_at(sort: Desc)], map: "idx_audit_logs_entity_lookup")
  @@index([institution_id, programme_id, academic_session_id, created_at(sort: Desc)], map: "idx_audit_logs_programme_scope")
  @@index([institution_id, project_id, created_at(sort: Desc)], map: "idx_audit_logs_project_time", where: raw("(project_id IS NOT NULL)"))
  @@index([institution_id, created_at(sort: Desc)], map: "idx_audit_logs_tenant_time")
}

