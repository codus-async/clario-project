  active_coordinator_appointment_id String?        @db.Uuid
  mfa_verified                      Boolean        @default(false)
  ip_address                        String?        @db.Inet
  user_agent                        String?
  inactivity_timeout_minutes        Int            @default(30)
  last_activity_at                  DateTime       @default(now()) @db.Timestamptz(6)
  expires_at                        DateTime       @db.Timestamptz(6)
  is_revoked                        Boolean        @default(false)
  revoked_reason                    String?        @db.VarChar(200)
  created_at                        DateTime       @default(now()) @db.Timestamptz(6)
  institutions                      institutions?  @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                             users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_revoked, expires_at], map: "idx_user_sessions_lookup")
  @@index([institution_id, is_revoked], map: "idx_user_sessions_tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                                                                     String                          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  institution_id                                                                         String?                         @db.Uuid
  is_platform_admin                                                                      Boolean                         @default(false)
  full_name                                                                              String                          @db.VarChar(120)
  email                                                                                  String                          @unique(map: "idx_users_platform_admin_email", where: raw("(is_platform_admin = true)")) @db.Citext
  institutional_id_number                                                                String?                         @db.Citext
  primary_department_id                                                                  String?                         @db.Uuid
  account_status                                                                         user_account_status_enum        @default(INVITED)
  is_under_18                                                                            Boolean                         @default(false)
  guardian_name                                                                          String?                         @db.VarChar(120)
  guardian_email                                                                         String?                         @db.Citext
  guardian_consent_status                                                                guardian_consent_status_enum    @default(NOT_REQUIRED_ADULT)
  password_hash                                                                          String?
  mfa_required                                                                           Boolean                         @default(false)
  mfa_enrolled                                                                           Boolean                         @default(false)
  mfa_secret_encrypted                                                                   String?
  mfa_recovery_codes_hash                                                                Json?
  failed_login_attempts                                                                  Int                             @default(0)
  locked_until                                                                           DateTime?                       @db.Timestamptz(6)
  invitation_token_hash                                                                  String?                         @db.Char(64)
  invitation_expires_at                                                                  DateTime?                       @db.Timestamptz(6)
  password_reset_token_hash                                                              String?                         @db.Char(64)
  password_reset_expires_at                                                              DateTime?                       @db.Timestamptz(6)
  last_login_at                                                                          DateTime?                       @db.Timestamptz(6)
  created_at                                                                             DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                                                                             DateTime                        @default(now()) @db.Timestamptz(6)
  consolidated_student_results                                                           consolidated_student_results[]
  coordinator_appointments                                                               coordinator_appointments[]
  examiner_appointments                                                                  examiner_appointments[]
  examiner_assessments                                                                   examiner_assessments[]
  in_app_notifications                                                                   in_app_notifications[]
  notification_dispatch_jobs                                                             notification_dispatch_jobs[]
  project_group_members                                                                  project_group_members[]
  project_supervision_history                                                            project_supervision_history[]
  projects                                                                               projects[]
  storage_objects                                                                        storage_objects[]
  student_project_registrations                                                          student_project_registrations[]
  submission_discussions                                                                 submission_discussions[]
  submission_versions                                                                    submission_versions[]
  supervisor_assessments_supervisor_assessments_institution_id_student_user_idTousers    supervisor_assessments[]        @relation("supervisor_assessments_institution_id_student_user_idTousers")
  supervisor_assessments_supervisor_assessments_institution_id_supervisor_user_idTousers supervisor_assessments[]        @relation("supervisor_assessments_institution_id_supervisor_user_idTousers")
  supervisor_records                                                                     supervisor_records?
  topic_proposals                                                                        topic_proposals[]
  user_role_assignments                                                                  user_role_assignments[]
  user_sessions                                                                          user_sessions[]
  institutions                                                                           institutions?                   @relation(fields: [institution_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([institution_id, email], map: "idx_users_tenant_email", where: raw("(institution_id IS NOT NULL)"))
  @@unique([institution_id, institutional_id_number], map: "idx_users_tenant_inst_id", where: raw("(institution_id IS NOT NULL)"))
  @@unique([institution_id, id])
  @@index([institution_id, primary_department_id, account_status], map: "idx_users_inst_dept_status", where: raw("(institution_id IS NOT NULL)"))
  @@index([invitation_token_hash], map: "idx_users_invitation_token", where: raw("(invitation_token_hash IS NOT NULL)"))
  @@index([password_reset_token_hash], map: "idx_users_reset_token", where: raw("(password_reset_token_hash IS NOT NULL)"))
}

