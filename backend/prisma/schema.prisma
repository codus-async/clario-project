generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model academic_sessions {
  id                            String                          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  institution_id                String                          @db.Uuid
  session_label                 String                          @db.VarChar(50)
  start_date                    DateTime                        @db.Date
  end_date                      DateTime                        @db.Date
  status                        academic_session_status_enum    @default(UPCOMING)
  closed_at                     DateTime?                       @db.Timestamptz(6)
  closed_by_user_id             String?                         @db.Uuid
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  institutions                  institutions                    @relation(fields: [institution_id], references: [id], onUpdate: NoAction)
  assessment_structures         assessment_structures[]
  coordinator_appointments      coordinator_appointments[]
  examination_panels            examination_panels[]
  late_penalty_rules            late_penalty_rules[]
  programme_milestones          programme_milestones[]
  project_groups                project_groups[]
  projects                      projects[]
  student_project_registrations student_project_registrations[]

  @@unique([institution_id, id])
  @@unique([institution_id, session_label])
  @@index([institution_id, status, start_date(sort: Desc)], map: "idx_academic_sessions_inst_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model assessment_structures {
  id                               String                    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  institution_id                   String                    @db.Uuid
  programme_id                     String                    @db.Uuid
  academic_session_id              String                    @db.Uuid
  total_max_marks                  Decimal                   @default(100.0000) @db.Decimal(10, 4)
  supervisor_max_marks             Decimal                   @default(30.0000) @db.Decimal(10, 4)
  examiner_document_max_marks      Decimal                   @default(40.0000) @db.Decimal(10, 4)
  examiner_defence_max_marks       Decimal                   @default(30.0000) @db.Decimal(10, 4)
  pass_mark_threshold              Decimal                   @default(45.0000) @db.Decimal(10, 4)
  examiner_consolidation_method    consolidation_method_enum @default(ARITHMETIC_MEAN)
  final_rounding_mode              rounding_mode_enum        @default(ROUND_HALF_UP_2DP)
  supervisor_criteria_jsonb        Json
  examiner_document_criteria_jsonb Json
  examiner_defence_criteria_jsonb  Json
  grade_scale_bands_jsonb          Json
  supervisor_assessment_due_utc    DateTime?                 @db.Timestamptz(6)
  is_locked                        Boolean                   @default(false)
  updated_by_coordinator_id        String                    @db.Uuid
  created_at                       DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                  @default(now()) @db.Timestamptz(6)
  academic_sessions                academic_sessions         @relation(fields: [institution_id, academic_session_id], references: [institution_id, id], onUpdate: NoAction)
  institutions                     institutions              @relation(fields: [institution_id], references: [id], onUpdate: NoAction)
  programmes                       programmes                @relation(fields: [institution_id, programme_id], references: [institution_id, id], onUpdate: NoAction)

  @@unique([institution_id, id])
  @@unique([institution_id, programme_id, academic_session_id])
}

